# Supabase — Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Ticket 4.7, optional. Cloudflare Turnstile's PUBLIC site key, which puts a
# bot check on the public RSVP form. Leave it unset and the form works without
# one — the rsvp Edge Function's rate limits apply either way.
#
# The matching SECRET key is not an app variable. It belongs to the function:
#   npx supabase secrets set TURNSTILE_SECRET_KEY=...
# The function skips verification entirely while that secret is absent, and
# says so in its response, so the downgrade is never silent.
VITE_TURNSTILE_SITE_KEY=
