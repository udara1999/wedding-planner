# Supabase — Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Ticket 4.7, optional. Cloudflare Turnstile's PUBLIC site key, which puts a
# bot check on the public RSVP form. Leave it unset and the form works without
# one — the rsvp Edge Function's rate limits apply either way.
#
# The matching SECRET key is not an app variable. It belongs to the function:
#   npx supabase secrets set TURNSTILE_SECRET_KEY=...
# The function skips verification entirely while that secret is absent, and
# says so in its response, so the downgrade is never silent.
VITE_TURNSTILE_SITE_KEY=

# Ticket 4.10, optional. Email invitations go through the `invite` Edge
# Function, which holds these — they are NOT app variables, because the app
# must never see the mail key:
#   npx supabase secrets set RESEND_API_KEY=... RESEND_FROM="Us <hello@your-domain>"
# Without them the function reports itself as unconfigured and the WhatsApp
# links carry on working.
